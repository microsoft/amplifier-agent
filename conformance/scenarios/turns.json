    "input": {"content": [{"type": "text", "text": "Wait for cancellation"}]},
    "cancel_after": "output_delta",
    "provider": [{"chunks": ["Waiting"], "block": true}],
    "expected": {"state": "cancelled", "code": "turn_cancelled", "effects": 0, "callbacks": 0}
  },
  {
