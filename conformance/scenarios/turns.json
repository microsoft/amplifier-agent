      {"role": "assistant", "content": [{"type": "text", "text": "Earlier answer"}]},
      {"role": "developer", "content": [{"type": "text", "text": "Preserve this history"}]}
    ]},
    "provider": [{"chunks": ["History preserved"], "text": "History preserved"}],
    "expected": {"state": "success", "text": "History preserved", "deltas": ["History preserved"], "effects": 0, "callbacks": 0}
  },
  {
    "id": "tool",
    "input": {"content": [{"type": "text", "text": "Call the counter"}]},
    "approvals": "allow",
