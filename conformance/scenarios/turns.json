    "provider": [{"tool": {"name": "counter", "arguments": {"value": 7}}}, {"chunks": ["Counted"], "text": "Counted"}],
    "expected": {"state": "success", "text": "Counted", "deltas": ["Counted"], "effects": 1, "callbacks": 1}
  },
  {
    "id": "approval",
    "input": {"content": [{"type": "text", "text": "Approve the counter"}]},
    "approvals": "handler",
    "tool": "counter",
    "provider": [{"tool": {"name": "counter", "arguments": {"value": 7}}}, {"chunks": ["Approved"], "text": "Approved"}],
    "expected": {"state": "success", "text": "Approved", "deltas": ["Approved"], "effects": 1, "callbacks": 1, "approvals": 1}
  },
  {
    "id": "denied",
    "input": {"content": [{"type": "text", "text": "Deny the counter"}]},
    "approvals": "deny",
    "tool": "counter",
    "provider": [{"tool": {"name": "counter", "arguments": {"value": 7}}}],
    "expected": {"state": "rejected", "code": "approval_denied", "effects": 0, "callbacks": 0}
  },
  {
