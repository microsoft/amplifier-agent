{
  "requirements": [
    {
      "check": "runtime.http.clients",
      "surface": "http",
      "cases": [
        "http.http.unmodified_openai_client_over_socket",
        "http-replacement.http.unmodified_openai_client_over_socket"
      ],
      "discrimination": "The unmodified OpenAI client must complete both modes over a socket without custom headers or dialect fields."
    },
    {
      "check": "runtime.http.final_reply",
      "surface": "http",
      "cases": [
        "http.contracts.server_tool_policy_and_reply_only_projection",
        "http.contracts.tool_turn_matches_binding_terminal_and_event_boundaries",
        "http-replacement.contracts.server_tool_policy_and_reply_only_projection",
        "http-replacement.contracts.tool_turn_matches_binding_terminal_and_event_boundaries"
      ],
      "discrimination": "Real built-in and MCP turns must return the terminal reply after tool execution, with no client-executed tool_calls response."
    },
    {
      "check": "runtime.http.projection",
      "surface": "http",
      "cases": [
        "http.contracts.server_tool_policy_and_reply_only_projection",
        "http.contracts.tool_turn_matches_binding_terminal_and_event_boundaries",
        "http.projection.projection_fixture_drops_every_non_reply_event",
        "http.projection.http_fixture_validators_discriminate_response_mutations",
        "http-replacement.contracts.server_tool_policy_and_reply_only_projection",
        "http-replacement.contracts.tool_turn_matches_binding_terminal_and_event_boundaries"
      ],
      "discrimination": "Real tool turns preserve binding output-event boundaries; a projection fixture carrying all eleven registered events rejects any non-reply content, and merged/split/reordered or unterminated streams fail."
    },
    {
      "check": "runtime.http.errors",
      "surface": "http",
      "cases": [
        "http.http.provider_failures_never_finish_successfully",
        "http.contracts.server_tool_policy_and_reply_only_projection",
        "http-replacement.http.provider_failures_never_finish_successfully",
        "http-replacement.contracts.server_tool_policy_and_reply_only_projection"
      ],
      "discrimination": "Provider failure before or after partial output never returns successful content/stop/DONE; static approval denial carries the registered code and error message/remedy."
    },
    {
      "check": "runtime.http.configuration",
      "surface": "http",
      "cases": [
        "http.contracts.startup_configuration_is_immutable_across_requests",
        "http.contracts.request_configuration_is_rejected_before_provider_work",
        "http.http.pinned_request_cases",
        "http-replacement.contracts.startup_configuration_is_immutable_across_requests",
        "http-replacement.contracts.request_configuration_is_rejected_before_provider_work",
        "http-replacement.http.pinned_request_cases"
      ],
      "discrimination": "Mutating AgentOptions/environment after startup or sending historical system/developer messages cannot replace the configured instructions/approval policy; request configuration is refused before provider work."
    },
    {
      "check": "runtime.http.unknown_model",
      "surface": "http",
      "cases": [
        "http.http.model_selection_and_fields",
        "http-replacement.http.model_selection_and_fields"
      ],
      "discrimination": "An unknown configured-agent model must receive selector_rejected, name the model and remedy, and cause no provider work."
    },
    {
      "check": "runtime.http.isolation",
      "surface": "http",
      "cases": [
        "http.contracts.request_sessions_close_without_retaining_history",
        "http.http.nonstream_stream_binding_parity_and_request_isolation",
        "http-replacement.contracts.request_sessions_close_without_retaining_history",
        "http-replacement.http.nonstream_stream_binding_parity_and_request_isolation"
      ],
      "discrimination": "Distinct requests must create distinct ephemeral sessions, preserve only their own history, and leave no listed durable sessions."
    },
    {
      "check": "runtime.http.history",
      "surface": "http",
      "cases": [
        "http.http.pinned_request_cases",
        "http-replacement.http.pinned_request_cases"
      ],
      "discrimination": "Every supported final role and ordered text-part history must reach the provider exactly once with TurnInput.content empty."
    },
    {
      "check": "runtime.http.invalid_history",
      "surface": "http",
      "cases": [
        "http.http.pinned_request_cases",
        "http.contracts.unsupported_history_is_rejected_before_provider_work",
        "http-replacement.http.pinned_request_cases",
        "http-replacement.contracts.unsupported_history_is_rejected_before_provider_work"
      ],
      "discrimination": "Empty history, tool/function roles and calls, media and non-text values must receive invalid_input with a remedy before provider requests."
    },
    {
      "check": "runtime.http.cleanup",
      "surface": "http",
      "cases": [
        "http.contracts.request_sessions_close_without_retaining_history",
        "http.http.session_closes_when_start_turn_rejects",
        "http.http.disconnect_settles_provider",
        "http-replacement.contracts.request_sessions_close_without_retaining_history",
        "http-replacement.http.session_closes_when_start_turn_rejects",
        "http-replacement.http.disconnect_settles_provider"
      ],
      "discrimination": "Success, streamed/non-streamed failure, early start-turn rejection and client disconnect must close/cancel request work; closed sessions reject further public operations."
    },
    {
      "check": "runtime.http.auth",
      "surface": "http",
      "cases": [
        "http.http.authentication_both_endpoints",
        "http-replacement.http.authentication_both_endpoints"
      ],
      "discrimination": "Missing and wrong bearer tokens must fail both endpoints before provider requests."
    },
    {
      "check": "runtime.http.bind",
      "surface": "http",
      "cases": [
        "http.projection.service_settings",
        "http.projection.launcher_uses_loopback_default"
      ],
      "discrimination": "Default settings and the actual launcher arguments must select 127.0.0.1 rather than a wildcard bind."
    },
    {
      "check": "runtime.http.tools_policy",
      "surface": "http",
      "cases": [
        "http.contracts.server_tool_policy_and_reply_only_projection",
        "http.contracts.request_configuration_is_rejected_before_provider_work",
        "http-replacement.contracts.server_tool_policy_and_reply_only_projection",
        "http-replacement.contracts.request_configuration_is_rejected_before_provider_work"
      ],
      "discrimination": "Built-in and MCP effects occur exactly once only under the server allow policy; deny prevents the independent effect ledger, and no client tool/approval configuration is accepted."
    },
    {
      "check": "runtime.http.binding_parity",
      "surface": "http",
      "cases": [
        "http.contracts.tool_turn_matches_binding_terminal_and_event_boundaries",
        "http.http.nonstream_stream_binding_parity_and_request_isolation",
        "http-replacement.contracts.tool_turn_matches_binding_terminal_and_event_boundaries",
        "http-replacement.http.nonstream_stream_binding_parity_and_request_isolation"
      ],
      "discrimination": "Both plain and tool turns must produce equal stream, nonstream and binding terminal text without changing output-event boundaries."
    },
    {
      "check": "static.http.request_fields",
      "surface": "http",
      "cases": [
        "http.http.pinned_request_cases",
        "http.projection.http_shapes_refuse_extra_fields_at_every_object",
        "http-replacement.http.pinned_request_cases"
      ],
      "discrimination": "Pinned valid/refused inputs exercise the real projection; adding an owned extension to any request object must fail both schema validation and projection."
    },
    {
      "check": "static.http.response_fields",
      "surface": "http",
      "cases": [
        "http.projection.http_fixture_validators_discriminate_response_mutations",
        "http.projection.http_shapes_refuse_extra_fields_at_every_object",
        "http.projection.projection_fixture_drops_every_non_reply_event"
      ],
      "discrimination": "Adding any extra response field, omitting terminal/error identity fields, or projecting a non-reply event must fail the frozen schema or stream assertions."
    },
    {
      "check": "static.records.agent",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_record_shapes_types_and_defaults",
        "repository.surface_contracts.record_validator_rejects_contract_mutations"
      ],
      "discrimination": "All public dataclass fields, annotations, required/default values and read-only records are pinned; missing/extra/retyped/redefaulted/newly-required mutants fail."
    },
    {
      "check": "static.records.options",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_record_shapes_types_and_defaults",
        "repository.surface_contracts.record_validator_rejects_contract_mutations"
      ],
      "discrimination": "AgentOptions and SessionOptions fields, strict alternatives and defaults are checked alongside every record; invented transport settings and changed defaults fail."
    },
    {
      "check": "static.records.errors",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.factory_and_error_record"
      ],
      "discrimination": "AgentError must retain the full inspectable field record, typed constructor, retryable false default, correlation id and details."
    },
    {
      "check": "static.records.events",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_record_shapes_types_and_defaults",
        "repository.surface_contracts.record_validator_rejects_contract_mutations"
      ],
      "discrimination": "Envelope and every public event-payload record must retain complete fields/types/defaults, exact-integer sequence and Decimal usage costs."
    },
    {
      "check": "static.surface.agent",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_operation_shapes",
        "repository.surface_contracts.operation_validator_rejects_contract_mutations",
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports",
        "repository.surface_contracts.factory_and_error_record"
      ],
      "discrimination": "Public operations must be complete with mapped async signatures; added/removed/overloaded/synchronous members, forbidden exports and direct handle constructors fail."
    },
    {
      "check": "static.surface.session",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_operation_shapes",
        "repository.surface_contracts.operation_validator_rejects_contract_mutations"
      ],
      "discrimination": "Session info/history remain read-only, run/start_turn take TurnInput, fork/close retain their mapped signatures, and public overloads/missing operations fail."
    },
    {
      "check": "static.surface.binding",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_operation_shapes",
        "repository.surface_contracts.operation_validator_rejects_contract_mutations",
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports",
        "repository.surface_contracts.public_record_shapes_types_and_defaults"
      ],
      "discrimination": "Exact public exports, handle members and option fields reject missing contract operations and binding-specific agent capabilities/configuration."
    },
    {
      "check": "static.surface.transport",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.public_operation_shapes",
        "repository.surface_contracts.operation_validator_rejects_contract_mutations",
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports",
        "repository.surface_contracts.public_record_shapes_types_and_defaults"
      ],
      "discrimination": "Public handles/options/records and exports are enumerated against mapped names; a transport port or extra construction parameter fails."
    },
    {
      "check": "static.surface.internals",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports",
        "repository.surface_contracts.public_record_shapes_types_and_defaults",
        "repository.surface_contracts.public_operation_shapes"
      ],
      "discrimination": "Exact export and shape sets refuse public engine/composition/configuration names; dependency controls also reject implementation imports through the face or records."
    },
    {
      "check": "static.surface.engine_language",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports",
        "repository.package_boundaries.sdk_import_without_engine_and_construction_failure_are_public"
      ],
      "discrimination": "The Python binding imports without the engine, refuses construction by a public error when absent, and exports no direct engine implementation."
    },
    {
      "check": "static.surface.cli",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.binding_packages_ship_no_agent_command"
      ],
      "discrimination": "Python console/gui entry points and the TypeScript bin map must not ship an agent command."
    },
    {
      "check": "static.binding.mapping",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.published_python_mapping_resolves_operations_and_records",
        "repository.surface_contracts.public_record_shapes_types_and_defaults",
        "repository.surface_contracts.public_operation_shapes"
      ],
      "discrimination": "The published operation mapping must exactly match the contract operation set and resolve every local method; all record mappings name exported shapes."
    },
    {
      "check": "static.versions",
      "surface": "python",
      "cases": [
        "repository.surface_contracts.surface_lint_rejects_added_and_missing_exports"
      ],
      "discrimination": "Surface lint must see the four independent public contract tokens and agent-interface/1 rather than package versions."
    },
    {
      "check": "runtime.config.booleans",
      "surface": "http",
      "cases": [
        "http.contracts.http_host_overrides_and_booleans_reach_wire",
        "http.contracts.http_ambiguous_host_booleans_fail_before_startup",
        "http-replacement.contracts.http_ambiguous_host_booleans_fail_before_startup"
      ],
      "discrimination": "Real HTTP startup refuses ambiguous boolean values; false, 0 and no strings become false and explicit booleans reach the provider wire."
    },
    {
      "check": "runtime.config.extra_params",
      "surface": "http",
      "cases": [
        "http.contracts.http_host_overrides_and_booleans_reach_wire",
        "http.contracts.request_configuration_is_rejected_before_provider_work",
        "http.contracts.http_host_overrides_cannot_replace_conversation_semantics",
        "http-replacement.contracts.request_configuration_is_rejected_before_provider_work",
        "http-replacement.contracts.http_host_overrides_cannot_replace_conversation_semantics"
      ],
      "discrimination": "Per-provider metadata and an unknown owned setting arrive verbatim at the selected provider; request fields and conversation-state overrides are refused."
    },
    {
      "check": "runtime.config.precedence",
      "surface": "http",
      "cases": [
        "http.contracts.http_startup_obeys_config_precedence"
      ],
      "discrimination": "Recorded requests identify the provider and model selected from defaults, file, environment and options; any override inversion contacts the wrong fixture or model."
    },
    {
      "check": "runtime.config.snapshot",
      "surface": "http",
      "cases": [
        "http.contracts.startup_configuration_is_immutable_across_requests",
        "http.contracts.http_host_options_and_connections_are_snapshotted",
        "http-replacement.contracts.startup_configuration_is_immutable_across_requests"
      ],
      "discrimination": "After app startup, mutations of options, host file, provider/model environment, credentials and endpoint cannot change subsequent requests or the server approval policy."
    },
    {
      "check": "runtime.config.unknown_host",
      "surface": "http",
      "cases": [
        "http.contracts.http_unknown_host_key_names_nearest_remedy",
        "http-replacement.contracts.http_unknown_host_key_names_nearest_remedy"
      ],
      "discrimination": "Misspelled file/environment keys must fail startup by name with the closest registered-key remedy."
    },
    {
      "check": "runtime.provider.override_stateless",
      "surface": "http",
      "cases": [
        "http.contracts.http_history_is_complete_even_with_retention_opt_in",
        "http.contracts.http_host_overrides_cannot_replace_conversation_semantics",
        "http-replacement.contracts.http_host_overrides_cannot_replace_conversation_semantics"
      ],
      "discrimination": "Explicit retention opt-in still sends complete caller-held history and no remote conversation handle; protected conversation overrides fail startup."
    },
    {
      "check": "runtime.provider.reasoning_replay",
      "surface": "http",
      "cases": [
        "http.contracts.http_reasoning_replays_within_one_turn_and_not_between_requests"
      ],
      "discrimination": "Anthropic/OpenAI/Gemini tool turns replay local reasoning signatures and tool results within the turn, while a new HTTP request carries no previous reasoning state."
    },
    {
      "check": "runtime.provider.retention",
      "surface": "http",
      "cases": [
        "http.contracts.http_history_is_complete_even_with_retention_opt_in",
        "http.contracts.http_reasoning_replays_within_one_turn_and_not_between_requests"
      ],
      "discrimination": "OpenAI requests send store false unless the host explicitly opts in, and all tested protocols avoid previous_response_id/conversation handles."
    },
    {
      "check": "runtime.provider.stateless",
      "surface": "http",
      "cases": [
        "http.contracts.http_history_is_complete_even_with_retention_opt_in",
        "http.contracts.http_reasoning_replays_within_one_turn_and_not_between_requests"
      ],
      "discrimination": "Every HTTP request sends complete supplied history, each tool continuation includes local inputs/results, and separate requests do not inherit conversation or reasoning."
    },
    {
      "check": "runtime.selection.ceilings",
      "surface": "http",
      "cases": [
        "http.contracts.http_delegation_cannot_exceed_server_ceiling",
        "http.contracts.http_primary_model_is_honored_or_refused",
        "http.contracts.request_configuration_is_rejected_before_provider_work",
        "http-replacement.contracts.http_delegation_cannot_exceed_server_ceiling",
        "http-replacement.contracts.request_configuration_is_rejected_before_provider_work"
      ],
      "discrimination": "Delegation above the configured server ceiling is refused before extra provider work; provider model substitution and per-request configuration cannot silently raise or replace primary selection."
    },
    {
      "check": "runtime.selection.one_provider",
      "surface": "http",
      "cases": [
        "http.contracts.http_startup_refuses_multiple_providers",
        "http.contracts.http_startup_obeys_config_precedence",
        "http-replacement.contracts.http_startup_refuses_multiple_providers"
      ],
      "discrimination": "Options, file and environment reject multiple providers including aggregator-plus-provider lists; valid requests reach exactly one selected provider."
    },
    {
      "check": "runtime.selection.primary",
      "surface": "http",
      "cases": [
        "http.contracts.http_primary_model_is_honored_or_refused"
      ],
      "discrimination": "Three controlled provider protocols return success for the selected model and selector_rejected when the reported model differs, without retrying."
    },
    {
      "check": "runtime.storage.workspace",
      "surface": "http",
      "cases": [
        "http.contracts.http_workspace_slug_validation",
        "http-replacement.contracts.http_workspace_slug_validation"
      ],
      "discrimination": "HTTP startup accepts minimum/maximum valid workspace slugs and rejects traversal, uppercase, leading-hyphen and overlength values from file and environment."
    },
    {
      "check": "static.config.keys",
      "surface": "http",
      "cases": [
        "repository.surface_contracts.host_configuration_key_registry",
        "http.contracts.http_host_configuration_refuses_excluded_controls",
        "http.contracts.http_all_registered_host_keys_are_accepted",
        "http-replacement.contracts.http_host_configuration_refuses_excluded_controls",
        "http-replacement.contracts.http_all_registered_host_keys_are_accepted"
      ],
      "discrimination": "Static enumeration pins exactly the six registered host keys; HTTP startup accepts their combined configuration and refuses all excluded composition/routing/mode/recipe controls."
    },
    {
      "check": "static.surface.cli",
      "surface": "http",
      "cases": [
        "repository.surface_contracts.http_service_has_no_command_configuration_surface",
        "http.contracts.request_configuration_is_rejected_before_provider_work",
        "http-replacement.contracts.request_configuration_is_rejected_before_provider_work"
      ],
      "discrimination": "The HTTP package exposes only its service launcher, whose function has no arguments or argument parser; provider overrides remain absent from request configuration."
    }
  ]
}
