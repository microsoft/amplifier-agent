# Adapted from https://github.com/github/gitignore/tree/1e16d8b20164dd98c97fedb5f1e6f46c65911111
# Python, Node, and Global/{Linux,Windows,macOS,VisualStudioCode,JetBrains,Vim}.

# Python builds and environments
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
wheels/
.venv/
venv/
env/
ENV/

# Tests, coverage, and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.pyright_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
.nyc_output/
*.lcov

# Node dependencies and generated packages
node_modules/
.pnpm-store/
.npm/
*.tsbuildinfo
*.tgz
packages/typescript/runtime/

# Local configuration and logs
.env
.env.*
!.env.example
*.log
npm-debug.log*

# Editor-local files; portable VS Code settings remain versionable
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/httpRequests/
http-client.private.env.json
*.swp
[._]*.sw[a-p]
[._]*.un~
.netrwhist
*~

# OS metadata
.DS_Store
._*
__MACOSX/
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
.fuse_hidden*
.nfs*
